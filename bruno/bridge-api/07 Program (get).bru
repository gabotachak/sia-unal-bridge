meta {
  name: 07 Program (get)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/campuses/{{campus}}/programs/{{program}}
  body: none
  auth: none
}

params:path {
  campus: {{campus}}
  program: {{program}}
}

assert {
  res.status: eq 200
}

docs {
  Miss en frío camina facultad->programa en vivo (ResolveProgram) — barato,
  no dispara el censo completo.
}
