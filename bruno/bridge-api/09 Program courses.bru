meta {
  name: 09 Program courses
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/campuses/{{campus}}/programs/{{program}}/courses
  body: none
  auth: none
}

params:query {
  ~include: schedules
  ~q: algoritmos
  ~max_age: 0
}

params:path {
  campus: {{campus}}
  program: {{program}}
}

assert {
  res.status: eq 200
}

docs {
  El catálogo del plan: las dos mitades (regular + libre elección de la
  sede). Si nunca se trajo, espera al SIA (X-Cache: miss, X-SIA-Fetch-Ms).
  Si existe pero está vencido (FreshnessCatalog), responde lo guardado al
  instante (X-Cache: stale) y lo refresca por detrás. ?max_age=0 obliga a
  esperar el SIA.

  ?q=, ?credits= y ?typology= filtran el catálogo guardado. ?include=schedules
  agrega los horarios de los grupos de cada asignatura.
}
