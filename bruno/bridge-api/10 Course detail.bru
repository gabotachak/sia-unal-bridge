meta {
  name: 10 Course detail
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/campuses/{{campus}}/programs/{{program}}/courses/{{code}}
  body: none
  auth: none
}

params:path {
  campus: {{campus}}
  program: {{program}}
  code: {{code}}
}

assert {
  res.status: eq 200
}

docs {
  El endpoint canónico. Correr dos veces: 1ra X-Cache: miss (con
  X-SIA-Fetch-Ms), 2da X-Cache: hit. ?max_age=0 fuerza refetch.
}
