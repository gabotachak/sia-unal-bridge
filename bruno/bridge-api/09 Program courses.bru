meta {
  name: 09 Program courses
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/campuses/{{campus}}/programs/{{program}}/courses
  body: none
  auth: none
}

params:path {
  campus: {{campus}}
  program: {{program}}
}

assert {
  res.status: eq 200
}

docs {
  Miss en frío: 2 POSTs al SIA (regular + electivas), ~5-10s. Mirar
  X-Cache/X-SIA-Fetch-Ms en la respuesta. Filtros opcionales: ?q= ?credits=
  ?typology=
}
