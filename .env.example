# Copiar a .env (gitignored) y ajustar. docker-compose lee .env solo para
# interpolar ${VAR} en docker-compose.yml; internal/config lee las mismas
# variables del proceso real, con los mismos defaults si faltan.

# Credenciales compartidas por el servicio `db` y por el DATABASE_URL que
# `api` arma internamente contra el hostname `db` (ver docker-compose.yml).
POSTGRES_USER=sia
POSTGRES_PASSWORD=sia
POSTGRES_DB=sia_bridge

# Para herramientas que corren en el HOST, no dentro de docker-compose:
# make migrate, go test ./internal/store/..., go run ./cmd/bridge suelto.
# Mismas credenciales de arriba, pero contra localhost, no contra `db`.
DATABASE_URL=postgres://sia:sia@localhost:5432/sia_bridge?sslmode=disable
TEST_DATABASE_URL=postgres://sia:sia@localhost:5432/sia_bridge?sslmode=disable

PORT=8080

SIA_BASE_URL=https://sia.unal.edu.co/Catalogo/facespublico/public/servicioPublico.jsf
SIA_POOL_SIZE=4

LOG_LEVEL=info

# Periodo académico vigente — el SIA solo expone el actual, no histórico.
SIA_TERM=2026-2
