meta {
  name: 13 Section seats
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/campuses/{{campus}}/programs/{{program}}/courses/{{code}}/sections/{{key}}/seats
  body: none
  auth: none
}

params:query {
  ~max_age: 0
}

params:path {
  campus: {{campus}}
  program: {{program}}
  code: {{code}}
  key: {{key}}
}

assert {
  res.status: eq 200
}

docs {
  El body siempre trae measured_at y age_seconds: nunca se sirve un cupo sin
  decir de cuándo es. changed_at es cuándo cambió el número por última vez.

  ?max_age=0 fuerza la medición; repetirlo antes de FETCH_COOLDOWN responde
  429 refresh_cooldown.
}
