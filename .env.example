# ╔══════════════════════════════════════════════════════════════════════╗
# ║  Copiar a .env (gitignored) y ajustar.                             ║
# ║  docker-compose.yml interpola estas variables con ${VAR:-default}.  ║
# ╚══════════════════════════════════════════════════════════════════════╝


# ── 1. Base de datos (servicio `db`) ─────────────────────────────────
# La imagen postgres:alpine las usa para crear usuario, contraseña y BD
# en el primer arranque. Son la FUENTE DE VERDAD de las credenciales.
POSTGRES_USER=sia
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sia_bridge
# Puerto expuesto en localhost para conectarse desde fuera de docker
DB_PORT=15432

# Dónde viven los datos de Postgres en el HOST. Bind mount, no volumen
# nombrado: un volumen nombrado acaba en /var/lib/docker, casi siempre el
# disco del sistema. Con esto la base se pone donde haya espacio.
# Sin default en docker-compose.yml: es obligatoria y depende de la máquina.
# Crear el directorio antes del primer `docker compose up`.
PGDATA_DIR=./pgdata


# ── 2. Backend / API (servicio `api`) ────────────────────────────────
# Puerto del HOST. Dentro del contenedor el servidor Go siempre escucha en
# 8080; esto sólo elige por dónde se llega desde afuera.
API_PORT=18080

# Scraper del SIA.
SIA_BASE_URL=https://sia.unal.edu.co/Catalogo/facespublico/public/servicioPublico.jsf
SIA_POOL_SIZE=80
SIA_TERM=2026-2

LOG_LEVEL=info

# Zona horaria de los contenedores. Sin esto (y sin tzdata en la imagen) los
# logs salen en UTC: 5 horas corridas respecto al cron que lanza los barridos.
TZ=America/Bogota


# Segundos mínimos entre dos `?max_age=` forzados sobre la MISMA asignatura.
# Por debajo de eso la API responde 429 con Retry-After, sin tocar el SIA.
# La lee el backend (servicio `api`) y también el build del front, que la usa
# para apagar el botón de "medir cupos". 0 desactiva el freno.
FETCH_COOLDOWN=300

# Límite de requests por IP (token bucket): RPS sostenido y ráfaga tolerada.
# Protege el pool de conexiones al SIA (techo medido: 80 sesiones concurrentes,
# ver docs/OPEN-QUESTIONS.md §5), no solo el propio servidor.
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=20

# Techo de cuánto espera un request en cola por una conexión del pool de SIA
# (sia.Pool.Acquire) antes de responder 503 busy. Sin esto la espera la
# acota solo la paciencia del cliente, no el server. 0 desactiva el techo
# (espera indefinida, el comportamiento viejo).
SIA_ACQUIRE_TIMEOUT_SECONDS=45


# ── 3. Frontend (servicio `web`) ─────────────────────────────────────
# Puerto expuesto del contenedor nginx en compose (host:contenedor).
WEB_PORT=13000

# Puerto del scope de test (servicio `web-test`, sia-test.gabotachak.dev):
# mismo front, pero /v1/ va a la API de PRODUCCIÓN (web/nginx.test.conf), no
# al contenedor `api` de este stack.
WEB_TEST_PORT=23000

# Puerto del dev server de Vite (npm run dev, fuera de compose).
VITE_DEV_PORT=3000

# URL del backend para el proxy de Vite en desarrollo local.
# En compose nginx usa el hostname interno `api`, no necesita esto.
VITE_API_TARGET=https://sia-api.gabotachak.dev

# Tiempo en segundos (default 1800 = 30 min) después del cual una asignatura 
# sin grupos se muestra con el signo '?' en lugar del '-' en la tabla.
VITE_STALE_SEATS_SECONDS=1800

# Apaga el banner rojo de "estamos experimentando problemas temporales
# actualizando la información" (web/src/components/Banner.tsx).
#
# AL REVÉS QUE EL RESTO: la variable APAGA, no prende.
#   línea comentada o borrada  → el banner SE VE   (estado por defecto)
#   línea presente             → el banner NO se ve
#
# Es a propósito. El aviso dice que los datos de abajo pueden estar viejos:
# olvidar una variable tiene que dejar un aviso de más, nunca un sitio que
# calla el problema. Por eso el default —sin tocar nada— es mostrarlo.
#
# Cuenta que EXISTA, no lo que diga: `VITE_INCIDENT_BANNER_OFF=false` también
# lo apaga. Para volver a verlo hay que comentar o borrar la línea.
#
# Se hornea en el bundle (el front es estático, no hay proceso que la lea en
# caliente), así que prenderlo o apagarlo es reconstruir la imagen:
#   docker compose build web && docker compose up -d --no-deps web
#VITE_INCIDENT_BANNER_OFF=1


# ── 3b. Refresher (servicio `refresher`, fase 2) ──────────────────────
# El Job que baja el catálogo entero para que ningún cliente pague el miss.
# Corre por cron, un modo por corrida, y sale. docs/FASE-2.md.

# Freno de mano: false hace que CUALQUIER modo salga con código 0 y un log,
# sin abrir una sola conexión al SIA. Apaga todo sin editar el crontab.
REFRESH_ENABLED=true

# Goroutines = conexiones. INVARIANTE: SIA_POOL_SIZE + REFRESH_POOL_SIZE <= 80,
# el techo medido de sesiones concurrentes del SIA (docs/OPEN-QUESTIONS.md §5).
REFRESH_WORKERS=2
REFRESH_POOL_SIZE=2

# Presupuesto de reloj. Siempre MENOR que el intervalo del cron: corta limpio
# y mañana la corrida siguiente sigue donde quedó (el checkpoint son los
# marcadores de frescura, no un cursor).
REFRESH_MAX_DURATION=4h

# Cortesía con un servidor público, no control de throughput: 2 workers rinden
# ~4 POSTs/s por su cuenta, esto es techo. 0 lo desactiva.
REFRESH_RATE_POSTS_PER_SEC=6

# TTL que cada barrido sostiene (ver la tabla de Cadencia en docs/FASE-2.md).
REFRESH_CATALOG_MAX_AGE=168h
REFRESH_DETAIL_MAX_AGE=24h

# Asignaturas del barrido de cupos. Es un CALENTADOR del hot set, no una
# garantía de frescura: el universo son ~10 000 asignaturas y un worker mide
# ~1/s. Empezar en 250 y subir con datos (~1 GB/día).
REFRESH_HOT_SET_SIZE=250


# ── 4. Solo para el HOST (fuera de compose) ──────────────────────────
# make migrate, go test, go run ./cmd/bridge suelto.
# Mismas credenciales que la sección 1, pero contra localhost (no `db`).
DATABASE_URL=postgres://sia:changeme@localhost:15432/sia_bridge?sslmode=disable
# Base SEPARADA. Los tests de store/ y cmd/refresher/ escriben de verdad:
# apuntarla a sia_bridge metió 28 planes de sedes falsas en producción y dejó
# /v1/status reportando 1408 planes donde el censo real son 1380.
# La crea deploy/initdb/01-test-database.sql en el primer arranque de `db`;
# en una base ya existente, a mano. Migrarla con: make migrate-test
TEST_DATABASE_URL=postgres://sia:changeme@localhost:15432/sia_bridge_test?sslmode=disable

