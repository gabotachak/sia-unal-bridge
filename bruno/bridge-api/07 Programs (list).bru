meta {
  name: 07 Programs (list)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/campuses/{{campus}}/programs?faculty={{faculty}}
  body: none
  auth: none
}

params:path {
  campus: {{campus}}
}

params:query {
  faculty: {{faculty}}
}

assert {
  res.status: eq 200
}

docs {
  faculty es un filtro OPCIONAL: quítalo y salen todos los planes de la sede.
  Sale gratis porque un miss de directorio llena todas las facultades en la
  misma cascada.
}
