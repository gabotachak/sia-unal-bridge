meta {
  name: 08 Program (get)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/campuses/{{campus}}/programs/{{program}}
  body: none
  auth: none
}

params:query {
  ~faculty: {{faculty}}
  ~level: pregrado
}

params:path {
  campus: {{campus}}
  program: {{program}}
}

assert {
  res.status: eq 200
}

docs {
  Resuelve el plan por código dentro de la sede. Si el código se repite
  entre facultades de la sede responde 300 con candidates: desempatar con
  ?faculty=.
}
