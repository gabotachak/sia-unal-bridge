meta {
  name: 12 Section
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/campuses/{{campus}}/programs/{{program}}/courses/{{code}}/sections/{{key}}
  body: none
  auth: none
}

params:path {
  campus: {{campus}}
  program: {{program}}
  code: {{code}}
  key: {{key}}
}

assert {
  res.status: eq 200
}

docs {
  key es el token entre paréntesis del grupo ('1', 'AMAZ-01', 'TUMA-01'),
  no el número de "Grupo N".
}
