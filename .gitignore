# Go
/bin/
/dist/
*.exe
*.test
*.out
vendor/

# entorno: cualquier .env local, salvo la plantilla versionada
.env
.env.*
!.env.example

# datos de Postgres del bind mount local (PGDATA_DIR en .env, default ./.pgdata)
/.pgdata/
/pgdata/
/pgdata*/

# macOS
.DS_Store

# editores
.vscode/
.idea/

# capturas y respuestas crudas del SIA (pueden ser MB)
/testdata/live/
*.har

# node: el de web/ lo ignora web/.gitignore; este cubre corridas desde la raíz
node_modules/

# tooling local de agentes, no es parte del proyecto. Las skills instaladas viven
# en .claude/skills/ y .agents/skills/; lo versionado es skills-lock.json (nombre,
# origen y hash de cada una), que se restaura con `npx skills experimental_install`.
.agents/
.claude/
graphify-out/
