# sia-unal-bridge — bloque para el Caddyfile compartido del server.
# Puertos según docker-compose.yml / .env de este proyecto. Si alguno choca
# con otro proyecto en el server, avisar para reasignar antes de aplicar.

sia-api.gabotachak.dev {
	# La API no comprime por su cuenta y un catálogo son ~300 KB de JSON.
	encode zstd gzip
	reverse_proxy localhost:18080
}

sia.gabotachak.dev {
	reverse_proxy localhost:13000
}

sia-test.gabotachak.dev {
	reverse_proxy localhost:23000
}
