meta {
  name: 13 Section seats
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/campuses/{{campus}}/programs/{{program}}/courses/{{code}}/sections/{{key}}/seats
  body: none
  auth: none
}

params:path {
  campus: {{campus}}
  program: {{program}}
  code: {{code}}
  key: {{key}}
}

assert {
  res.status: eq 200
}

docs {
  Body siempre trae age_seconds — nunca se sirve un cupo sin decir de cuándo es.
}
