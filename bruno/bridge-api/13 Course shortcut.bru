meta {
  name: 13 Course shortcut
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/campuses/{{campus}}/courses/{{code}}
  body: none
  auth: none
}

params:path {
  campus: {{campus}}
  code: {{code}}
}

assert {
  res.status: eq 200
}

docs {
  Ambiguo por diseño: 0 programas -> 404, 1 -> 200 con el detalle, N -> 300
  con candidates. Resuelve solo contra lo ya cacheado (nunca dispara SIA
  para DESCUBRIR qué programas lo ofrecen).
}
